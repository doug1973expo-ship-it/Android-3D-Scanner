<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#101416">
    <android.opengl.GLSurfaceView android:id="@+id/surface" android:layout_width="match_parent" android:layout_height="match_parent" />
    <View android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="center"
        android:background="@drawable/scan_frame" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="92dp"
        android:padding="10dp" android:background="#AA101416" android:textColor="#FFFFFF"
        android:text="Keep the object inside the frame" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top"
        android:orientation="vertical" android:padding="18dp" android:background="#AA101416">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Move slowly around the object" android:textColor="#FFFFFF" android:textSize="18sp" />
        <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="0 surface cells • green = scanned" android:textColor="#B8C4C8" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="horizontal" android:gravity="center" android:padding="16dp" android:background="#CC101416">
        <Button android:id="@+id/scanButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Start scan" />
        <Button android:id="@+id/exportButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="Export STL" android:enabled="false" />
        <Button android:id="@+id/clearButton" android:layout_width="wrap_content" android:layout_height="56dp"
            android:layout_marginStart="10dp" android:text="Clear" />
    </LinearLayout>
</FrameLayout>
